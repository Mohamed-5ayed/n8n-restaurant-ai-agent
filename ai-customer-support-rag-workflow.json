        "jsCode": "const items = $input.all();\nconst outputItems = [];\n\nconst targetPrefix = \"[HUMAN_NEEDED]\";\n\nfor (const item of items) {\n  const text = item.json.output || \"\";\n  \n  if (text.trim().startsWith(targetPrefix)) {\n    // استخراج رسالة العميل وإزالة الكلمة\n    const clientMessage = text.replace(targetPrefix, \"\").trim();\n    \n    outputItems.push({\n      json: {\n        message: clientMessage,\n        needsHuman: true,       // علامة تفيد بأن هناك حاجة لتدخل بشري\n        fullDetails: text\n      }\n    });\n  } else {\n    outputItems.push({\n      json: {\n        message: text,\n        needsHuman: false,      // رسالة عادية\n        fullDetails: text\n      }\n    });\n  }\n}\n\nreturn outputItems;"
      },
